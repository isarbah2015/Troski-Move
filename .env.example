# Database
DATABASE_URL=postgresql://trotrolink:trotrolink@localhost:5432/trotrolink

# Auth
JWT_SECRET=change-me
OTP_SMS_PROVIDER=hubtel

# MTN MoMo (Collections). Leave MTN_MOMO_API_KEY empty to run in MOMO_SIMULATOR_MODE:
# payments auto-approve after 3 seconds and no money moves.
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENV=sandbox
MTN_MOMO_COLLECTION_ACCOUNT_ID=
# Sandbox only accepts EUR; production Ghana is GHS (defaults follow the target env).
MTN_MOMO_CURRENCY=
# MTN's published sandbox test payer that always approves.
MTN_MOMO_SANDBOX_PAYER=46733123450
# MTN does not sign callbacks, so the callback URL carries this secret as ?token=...
MTN_MOMO_WEBHOOK_SECRET=
MTN_MOMO_CALLBACK_URL=https://your-domain.com/api/payments/webhook?token=<MTN_MOMO_WEBHOOK_SECRET>

# Hubtel (SMS + MoMo fallback)
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=

# Africa's Talking (USSD)
AT_API_KEY=
AT_USERNAME=
AT_SHORT_CODE=*123#

# Mapbox
MAPBOX_ACCESS_TOKEN=

# Firebase (push)
FIREBASE_SERVER_KEY=

# GTFS
GTFS_ACCRA_URL=https://github.com/trufi-association/trufi-gtfs-builder/raw/main/examples/Ghana-Accra/out/gtfs/accra.gtfs.zip

# App config
API_URL=http://localhost:4000
PORT=4000
