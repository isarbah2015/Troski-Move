{
  "expo": {
    "name": "TrotroLink",
    "slug": "trotrolink",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "trotrolink",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#060A13"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.trotrolink.mobile"
    },
    "android": {
      "package": "app.trotrolink.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#060A13"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "./plugins/withGradleMemory",
      [
        "expo-notifications",
        {
          "color": "#10B981"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TrotroLink uses your location to find the stop you are at and to follow your trip. It is only used while you ride."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "TrotroLink uses the camera to scan the QR sticker in the trotro."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
